# Prueba rapida de compilacion y conteo.
/control/verbose 1
/run/verbose 1
/testem/det/setMat G4_Al
/testem/det/setSize 1 cm
/run/initialize
/process/inactivate phot
/process/inactivate conv
/process/inactivate GammaToMuPair
/gun/particle gamma
/gun/energy 300 keV
/random/setSeeds 12345 67890
/run/beamOn 1000
